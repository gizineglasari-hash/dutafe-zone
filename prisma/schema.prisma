generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  role         String        @default("PARTICIPANT") // PARTICIPANT | ADMIN
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  participant  Participant?
  resetTokens  PasswordResetToken[]
  nutritionAssessments NutritionAssessment[]
}

// Token reset password (alur "Lupa Password" via email).
// Yang disimpan hanya HASH token (sha256) — token asli hanya ada di link email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Participant {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  age             Int
  school          String
  schoolCity      String? // Kota sekolah (dari daftar sekolah)
  schoolDistrict  String? // Kecamatan sekolah
  schoolType      String? // Negeri | Swasta
  educationLevel  String // SMP | SMA
  avatar          String   @default("🌸")
  profilePhotoUrl String?  // foto profil (mis. /uploads/profile/xxx.jpg)
  phone           String? // nomor telepon/WhatsApp (wajib pendaftar baru; akun lama boleh kosong)
  nik             String? // Nomor Induk Kependudukan — 16 digit (wajib pendaftar baru; akun lama boleh kosong).
                          // Disimpan TEXT (bukan angka) agar angka 0 di depan tidak hilang.
  xp              Int      @default(0)
  streakWeeks     Int      @default(0)
  lastCheckIn     String? // YYYY-MM-DD
  preTestScore    Int?
  postTestScore   Int?
  hbValue         Float?   // Hasil pemeriksaan hemoglobin (g/dL) — diisi peserta di Profil
  hbCheckDate     DateTime? // Tanggal pemeriksaan Hb terakhir
  isDutaCandidate Boolean  @default(false)
  isDuta          Boolean  @default(false)
  jenisKelamin    String?  // "L" | "P" — diingat dari fitur Cek Status Gizi (pembaruan 17)
  tanggalLahir    DateTime? // diingat dari fitur Cek Status Gizi agar isi formulir otomatis
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  missionProgress  MissionProgress[]
  nutritionAssessments NutritionAssessment[]
  badges           ParticipantBadge[]
  ttdCheckIns      TTDCheckIn[]
  quizResults      QuizResult[]
  activityLogs     ActivityLog[]
  videoSubmissions VideoSubmission[]
  dutaStage        DutaStage?
  communityContent CommunityContent[]
  missionShares    MissionShare[]
  pushSubscriptions PushSubscription[]
  reminderLogs     TtdReminderLog[]
}

// ============================================================
// Misi Buatan Admin (pembaruan 15)
// Satu baris = satu misi tambahan yang dibuat admin lewat panel.
// Muncul di Mission Center peserta sebagai "Misi Tambahan".
// Penyelesaian dicatat di tabel MissionProgress dengan missionKey
// "CUST:<id>" — idempoten (XP hanya sekali per peserta).
// ============================================================
model CustomMission {
  id          String   @id @default(cuid())
  title       String
  icon        String   @default("⭐")
  description String
  xp          Int      @default(50)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Pengingat TTD (Web Push)
// Satu baris = satu perangkat (browser/HP) yang mengizinkan
// notifikasi. Endpoint unik per perangkat dari browser.
// ============================================================
model PushSubscription {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  endpoint      String   @unique // URL unik per perangkat dari push service
  p256dh        String // kunci enkripsi publik perangkat
  auth          String // kunci enkripsi auth perangkat
  userAgent     String? // info browser/HP (opsional, utk admin)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([participantId])
}

// Log pengiriman pengingat TTD — dipakai agar pengingat tidak
// pernah dobel (idempoten): maks 1x per 7 hari per peserta.
model TtdReminderLog {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sentAt        DateTime @default(now())
  success       Boolean  @default(true)
  error         String? // pesan error jika gagal kirim
  kind          String   @default("weekly") // weekly | test

  @@index([participantId, sentAt])
  @@index([sentAt])
}

// ============================================================
// Editor Konten Edukasi (PAKET C)
// Satu baris = satu kategori edukasi (mis. "anemia", "ttd")
// yang pernah DIEDIT oleh admin. Isinya JSON lengkap kategori.
// Kalau barisnya dihapus / belum ada → aplikasi otomatis
// memakai konten bawaan dari src/lib/content-edukasi.ts,
// jadi website tidak pernah bisa kosong karena salah edit.
// ============================================================
model EduContent {
  key       String   @id // "anemia" | "ttd" | "food" | "vitc" | "pola" | "myth" | "tips"
  dataJson  String // JSON kategori: icon, title, subtitle, tip, cards[]
  updatedAt DateTime @updatedAt
}

// ============================================================
// Editor Soal / Bank Kuis (PAKET C lanjutan)
// Satu baris = satu bank soal yang pernah DIEDIT admin.
// key: PRETEST | POSTTEST | M1 | M2 | MITOS | FINAL_QUIZ
// Isinya JSON soal versi admin. Kalau baris dihapus / belum
// ada → penilaian & tampilan otomatis memakai soal bawaan
// dari src/lib/content-quizzes.ts, jadi kuis tidak pernah
// bisa rusak karena salah edit.
// ============================================================
model QuizContent {
  key       String   @id
  dataJson  String // JSON bank soal (questions / levels SMP-SMA / myths)
  updatedAt DateTime @updatedAt
}

model MissionProgress {
  id           String    @id @default(cuid())
  participantId String
  participant  Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  missionKey   String // M1..M9
  status       String    @default("LOCKED") // LOCKED | STARTED | COMPLETED
  progress     Int       @default(0) // 0-100
  score        Int? // nilai terbaik saat lulus (0-100)
  xpAwarded    Int       @default(0) // XP misi yang sudah diberikan (anti duplikasi)
  dataJson     String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([participantId, missionKey])
}

model TTDCheckIn {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD
  xp            Int      @default(10)
  createdAt     DateTime @default(now())

  @@unique([participantId, date])
}

model ParticipantBadge {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  badgeKey      String
  earnedAt      DateTime @default(now())

  @@unique([participantId, badgeKey])
}

model QuizResult {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  quizKey       String // M1, M2, PRETEST, POSTTEST, MITOS, FINAL_QUIZ
  score         Int // 0-100
  correct       Int
  total         Int
  detailJson    String?
  createdAt     DateTime @default(now())
}

model ActivityLog {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  type          String // REGISTER, LOGIN, PRETEST, MISSION_DONE, CHECKIN, BADGE, XP, SHARE, VIDEO_UPLOAD, DUTA_STAGE
  meta          String?
  createdAt     DateTime @default(now())
}

model VideoSubmission {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  missionKey    String // M8 | DUTA_VIDEO
  fileName      String
  fileUrl       String
  durationSec   Int?
  status        String   @default("PENDING") // PENDING | GRADED
  grade         Int? // 0-100
  adminNote     String?
  xpAwarded     Int?
  createdAt     DateTime @default(now())
}

model DutaStage {
  id             String    @id @default(cuid())
  participantId  String    @unique
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  stage1Posttest Boolean   @default(false)
  stage2Quiz     Boolean   @default(false)
  stage3Peer     Boolean   @default(false)
  stage4Video    Boolean   @default(false)
  stage5Presentation String?
  completedAt    DateTime?
  dataJson       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============================================================
// Komunitas & Peer Educator (content moderation + likes + shares)
// ============================================================
model CommunityContent {
  id              String        @id @default(cuid())
  participantId   String
  participant     Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contentType     String        @default("peer_educator") // education | peer_educator
  title           String
  description     String? // caption / deskripsi
  platform        String        @default("uploaded") // youtube | instagram | tiktok | uploaded | none
  externalUrl     String? // URL YouTube/Instagram/TikTok
  videoUrl        String? // file upload (/uploads/...) atau URL canonical
  thumbnailUrl    String?
  status          String        @default("PENDING") // PENDING | APPROVED | REJECTED
  durationSec     Int?
  rejectReason    String?
  likesCount      Int           @default(0) // denormalisasi utk leaderboard/feed
  xpAwarded       Int           @default(0)
  xpGiven         Boolean       @default(false) // cegah XP ganda per konten
  likeBonusXp     Int           @default(0) // total XP bonus like yg sudah diberikan
  likeBonusMilestones Int       @default(0) // jumlah milestone 10-like yg sudah diaward
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  likes ContentLike[]
}

model ContentLike {
  id        String           @id @default(cuid())
  contentId String
  content   CommunityContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String // User.id — 1 akun = 1 like per konten (unique)
  createdAt DateTime         @default(now())

  @@unique([contentId, userId])
}

model MissionShare {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contentId     String? // key materi edukasi yg dibagikan (mis. EDU_ANEMIA)
  platform      String // instagram | tiktok | youtube | whatsapp | copy_link
  shareCount    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([participantId, contentId, platform])
}

model AppSetting {
  key   String @id
  value String
}

// ============================================================
// CEK STATUS GIZI (pembaruan 17)
// Satu baris = SATU pemeriksaan status gizi peserta.
// Setiap pengecekan membuat baris BARU (riwayat tidak pernah
// ditimpa). Semua angka dihitung server-side memakai WHO Growth
// Reference 2007 (metode LMS / WHO AnthroPlus), usia 5–19 tahun.
// Keamanan setara RLS: akses hanya lewat API route yang selalu
// memeriksa session — peserta hanya bisa membaca baris miliknya
// sendiri; admin (role ADMIN) bisa membaca semua.
// ============================================================
model NutritionAssessment {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id") // wajib: dari session yang terautentikasi
  participantId      String   @map("participant_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant        Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  namaPeserta        String   @map("nama_peserta") // snapshot nama saat diperiksa
  jenisKelamin       String   @map("jenis_kelamin") // "L" | "P"
  tanggalLahir       DateTime @map("tanggal_lahir") @db.Date
  tanggalPemeriksaan DateTime @map("tanggal_pemeriksaan") @db.Date
  // usia presisi (bukan selisih tahun saja)
  usiaTahun          Int      @map("usia_tahun")
  usiaBulan          Int      @map("usia_bulan")
  usiaHari           Int      @map("usia_hari")
  usiaDalamHari      Int      @map("usia_dalam_hari")
  // pengukuran & hasil
  beratBadanKg       Decimal  @map("berat_badan_kg") @db.Decimal(5, 2)
  tinggiBadanCm      Decimal  @map("tinggi_badan_cm") @db.Decimal(5, 1)
  imt                Decimal  @db.Decimal(6, 4) // BB/TB(m)^2 — disimpan presisi penuh (ditampilkan 1–2 desimal)
  tbUZscore          Decimal  @map("tb_u_zscore") @db.Decimal(5, 2)
  tbUPercentile      Decimal  @map("tb_u_percentile") @db.Decimal(5, 2)
  tbUStatus          String   @map("tb_u_status")
  imtUZscore         Decimal  @map("imt_u_zscore") @db.Decimal(5, 2)
  imtUPercentile     Decimal  @map("imt_u_percentile") @db.Decimal(5, 2)
  imtUStatus         String   @map("imt_u_status")
  // referensi yang dipakai
  referenceStandard  String   @map("reference_standard") @default("WHO Growth Reference 2007")
  referenceVersion   String   @map("reference_version") @default("Tabel expanded LMS WHO, metode WHO AnthroPlus")
  // versi algoritma kalkulator (pembaruan 18 — audit presisi Z-score).
  // v2 = round(hari/30,4375) — identik WHO AnthroPlus. Nullable agar
  // baris lama (v1) tetap utuh tanpa migrasi merusak.
  calculationVersion String?  @map("calculation_version")
  // perkiraan BB sesuai tinggi badan (WHO 2007 perempuan) — nullable agar
  // data pemeriksaan LAMA tetap utuh tanpa migrasi merusak
  bbMedianWho        Decimal? @map("bb_median_who") @db.Decimal(5, 2)
  bbMinWho           Decimal? @map("bb_min_who") @db.Decimal(5, 2)
  bbMaxWho           Decimal? @map("bb_max_who") @db.Decimal(5, 2)
  whoReference       String?  @map("who_reference") // "WHO 2007 Female 5-19 years"
  // teks ramah remaja
  interpretation     String
  recommendation     String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([participantId, tanggalPemeriksaan])
  @@index([tanggalPemeriksaan])
  @@map("nutrition_assessments")
}

// ============================================================
// Analisa kunjungan web (ala Vercel Analytics)
// Satu baris = satu kunjungan halaman (pageview) anonim.
// visitorId acak tersimpan di browser pengunjung (localStorage).
// ============================================================
model PageView {
  id        String   @id @default(cuid())
  visitorId String
  path      String // contoh: "/", "/masuk", "/app/missions", "/lupa-password"
  referrer  String?
  device    String   @default("Desktop") // Desktop | Mobile | Tablet
  browser   String   @default("Lainnya")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorId, createdAt])
}
